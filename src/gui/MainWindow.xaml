<Window x:Class="WinMouseFix.Gui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:WinMouseFix.Gui.Controls"
        xmlns:componentModel="clr-namespace:System.ComponentModel;assembly=WindowsBase"
        Title="Win Mouse Fix"
        Width="480" Height="420" MinWidth="440" MinHeight="360"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded"
        PreviewMouseMove="Window_MouseActivity"
        PreviewMouseDown="Window_MouseActivity"
        PreviewMouseWheel="Window_MouseActivity"
        PreviewKeyDown="Window_KeyActivity"
        Closing="Window_Closing">
    <Window.Resources>
        <controls:TriggerActionOptionsConverter x:Key="TriggerActionOptionsConverter" />
        <controls:ModifierShortcutConverter x:Key="ModifierShortcutConverter" />
        
        <Style x:Key="TriggerLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Text" Value="{Binding Trigger}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Trigger}" Value="click"><Setter Property="Text" Value="点按" /></DataTrigger>
                <DataTrigger Binding="{Binding Trigger}" Value="doubleClick"><Setter Property="Text" Value="连按" /></DataTrigger>
                <DataTrigger Binding="{Binding Trigger}" Value="hold"><Setter Property="Text" Value="按住" /></DataTrigger>
                <DataTrigger Binding="{Binding Trigger}" Value="holdScroll"><Setter Property="Text" Value="点按并滚动" /></DataTrigger>
                <DataTrigger Binding="{Binding Trigger}" Value="holdDrag"><Setter Property="Text" Value="点按并拖移" /></DataTrigger>
                <DataTrigger Binding="{Binding Trigger}" Value="dragUp"><Setter Property="Text" Value="向上拖移" /></DataTrigger>
                <DataTrigger Binding="{Binding Trigger}" Value="dragDown"><Setter Property="Text" Value="向下拖移" /></DataTrigger>
                <DataTrigger Binding="{Binding Trigger}" Value="dragLeft"><Setter Property="Text" Value="向左拖移" /></DataTrigger>
                <DataTrigger Binding="{Binding Trigger}" Value="dragRight"><Setter Property="Text" Value="向右拖移" /></DataTrigger>
                <DataTrigger Binding="{Binding Trigger}" Value="wheelUp"><Setter Property="Text" Value="向上滚动" /></DataTrigger>
                <DataTrigger Binding="{Binding Trigger}" Value="wheelDown"><Setter Property="Text" Value="向下滚动" /></DataTrigger>
            </Style.Triggers>
        </Style>

        <CollectionViewSource x:Key="GroupedRemaps" Source="{Binding Remaps}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="Button" />
            </CollectionViewSource.GroupDescriptions>
            <CollectionViewSource.SortDescriptions>
                <componentModel:SortDescription PropertyName="Button" Direction="Ascending" />
                <componentModel:SortDescription PropertyName="TriggerOrder" Direction="Ascending" />
            </CollectionViewSource.SortDescriptions>
        </CollectionViewSource>
    </Window.Resources>

    <Grid x:Name="RootLayout">
        <Grid.RowDefinitions>
            <RowDefinition Height="52" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid Height="52">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <RadioButton x:Name="GeneralNavigation" Content="通用" GroupName="Navigation" Tag="&#xE713;"
                                 Style="{StaticResource TopNavigationItem}" Checked="Navigation_Checked" />
                    <RadioButton x:Name="ButtonsNavigation" Content="按键" GroupName="Navigation" Tag="&#xE790;"
                                 Style="{StaticResource TopNavigationItem}" Checked="Navigation_Checked" />
                    <RadioButton x:Name="ScrollNavigation" Content="滚动" GroupName="Navigation" Tag="&#xE752;"
                                 Style="{StaticResource TopNavigationItem}" Checked="Navigation_Checked" />
                    <Grid>
                        <RadioButton x:Name="AboutNavigation" Content="关于" GroupName="Navigation" Tag="&#xE946;"
                                     Style="{StaticResource TopNavigationItem}" Checked="Navigation_Checked" />
                        <Ellipse x:Name="UpdateBadge" Width="7" Height="7" Fill="#E5484D"
                                 HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,4,0"
                                 Visibility="Collapsed" />
                    </Grid>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,18,0">
                    <Ellipse x:Name="AppStatusDot" Width="7" Height="7" Fill="#107C41" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid x:Name="ContentHost" Grid.Row="1">
            <ScrollViewer x:Name="GeneralPage" VerticalScrollBarVisibility="Disabled"
                          HorizontalScrollBarVisibility="Disabled"
                          HorizontalContentAlignment="Center">
                <StackPanel Width="440" Margin="0,14,0,18">
                    <TextBlock Text="控制软件的运行偏好，排除特定应用，以及管理配置方案与更新。" Style="{StaticResource PageDescription}" />

                    <!-- 卡片 1：主开关与配置管理 (大标题启动开关) -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid Margin="0,2,0,10">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="启动 Win Mouse Fix" FontSize="15" FontWeight="SemiBold" Foreground="#1E293B" />
                                    <TextBlock Text="开启后应用当前手势与滚轮设置。" Foreground="{StaticResource MutedTextBrush}" FontSize="11.5" Margin="0,3,0,0" />
                                </StackPanel>
                                <CheckBox x:Name="AppEnabledToggle" Grid.Column="1"
                                          Style="{StaticResource ToggleSwitch}"
                                          VerticalAlignment="Center"
                                          AutomationProperties.Name="启动 Win Mouse Fix"
                                          IsChecked="{Binding Enabled, Mode=TwoWay}"
                                          Click="AppEnabledToggle_Click" />
                            </Grid>



                            <Border Height="1" Background="#F0F0F0" Margin="0,2" />

                            <!-- 配置管理整合在运行偏好底部 -->
                            <Grid Margin="0,8,0,2">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="配置方案管理" FontWeight="SemiBold" />
                                    <TextBlock Text="新建、切换、导出或恢复多套按键配置档案。" Foreground="{StaticResource MutedTextBrush}" FontSize="11.5" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="管理方案…" VerticalAlignment="Center" Click="OpenProfileManager_Click" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 卡片 2：应用排除 (圆角矩形输入框、紧凑条目、红色移除按钮、3个以上极细滚动条) -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="应用排除" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="进入列表中的应用后，按键和滚轮保持系统原始行为。"
                                       Foreground="{StaticResource MutedTextBrush}" Margin="0,2,0,10" FontSize="11.5" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Background="White" BorderBrush="#E3E3E3" BorderThickness="1" CornerRadius="6" Height="28">
                                    <TextBox x:Name="ApplicationPathTextBox" BorderThickness="0" Background="Transparent"
                                             Padding="8,0" VerticalContentAlignment="Center" ToolTip="应用 .exe 路径" FontSize="11.5" />
                                </Border>
                                <Button Grid.Column="1" Content="浏览" Height="28" Padding="12,0" Margin="6,0" Click="BrowseApplication_Click" />
                                <Button Grid.Column="2" Content="添加" Style="{StaticResource PrimaryButton}" Height="28" Padding="12,0" Click="AddApplication_Click" />
                            </Grid>
                            <TextBlock x:Name="EmptyApplicationsText" Text="还没有添加应用。"
                                       Foreground="{StaticResource MutedTextBrush}" Margin="0,10,0,0" FontSize="11.5" />
                            <ScrollViewer Style="{StaticResource SlimScrollViewer}" MaxHeight="106" Margin="0,4,0,0"
                                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding ExcludedApps}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,4,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Border Background="#F8F9FB" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="5" Padding="8,4">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="11.5" />
                                                        <TextBlock Text="{Binding Path}" Foreground="{StaticResource MutedTextBrush}"
                                                                   FontSize="10.5" TextTrimming="CharacterEllipsis" Margin="0,1,0,0" />
                                                    </StackPanel>
                                                </Border>
                                                <Button Grid.Column="1" Content="移除" Margin="6,0,0,0" Height="26" Padding="8,0"
                                                        Foreground="#DC2626"
                                                        CommandParameter="{Binding}" Click="RemoveApplication_Click">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="BtnBorder" Background="#FFF1F2" BorderBrush="#FECDD3" BorderThickness="1" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                                <TextBlock Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="BtnBorder" Property="Background" Value="#FFE4E6" />
                                                                    <Setter TargetName="BtnBorder" Property="BorderBrush" Value="#FDA4AF" />
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <Grid x:Name="ButtonsPage" Visibility="Collapsed" Width="440" Margin="0,14,0,18"
                  HorizontalAlignment="Center">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 纯净大“＋”号录入区 -->
                <Border x:Name="CaptureArea" Height="150" Margin="0,0,0,0" CornerRadius="10"
                        BorderBrush="#E3E3E3" BorderThickness="1" Background="#F0F1F4"
                        MouseEnter="CaptureArea_MouseEnter" MouseLeave="CaptureArea_MouseLeave"
                        PreviewMouseDown="CaptureArea_PreviewMouseDown"
                        PreviewMouseUp="CaptureArea_PreviewMouseUp"
                        PreviewMouseMove="CaptureArea_PreviewMouseMove"
                        PreviewMouseWheel="CaptureArea_PreviewMouseWheel"
                        LostMouseCapture="CaptureArea_LostMouseCapture">
                    <Border.RenderTransform>
                        <TranslateTransform x:Name="CaptureTransform" Y="0" />
                    </Border.RenderTransform>
                    <Border.Effect>
                        <DropShadowEffect x:Name="CaptureGlowEffect" Color="#000000" BlurRadius="4" ShadowDepth="1.5" Opacity="0" />
                    </Border.Effect>
                    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock x:Name="CapturePlusIcon" Text="＋" FontSize="36" FontWeight="Normal" Foreground="#8E95A2"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0" />
                        <TextBlock x:Name="CaptureStateText" Visibility="Collapsed" />
                    </Grid>
                </Border>

                <!-- 正下方原版地道提示词 -->
                <StackPanel Grid.Row="1" Margin="0,8,0,10" HorizontalAlignment="Center">
                    <TextBlock Text="移动鼠标指针到 “+” 区域内，然后点击鼠标按键来指定动作。"
                               FontSize="11.5" Foreground="#7E8694" HorizontalAlignment="Center" />
                    <TextBlock Text="您也可以连按、点按并拖移或执行更多操作。"
                               FontSize="11.5" Foreground="#7E8694" HorizontalAlignment="Center" Margin="0,3,0,0" />
                </StackPanel>

                <!-- macOS 双列表格卡片 -->
                <Border x:Name="MappingsPanel" Grid.Row="2" Background="White" BorderBrush="#E3E3E3"
                        BorderThickness="1" CornerRadius="7" Margin="0,0,0,8"
                        >
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border x:Name="EmptyRemapsText" Background="Transparent" Margin="20,28" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="&#xE962;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                           FontSize="28" Foreground="#C0C5CC" HorizontalAlignment="Center" Margin="0,0,0,8" />
                                <TextBlock Text="还没有添加任何手势映射" FontWeight="SemiBold" FontSize="13"
                                           HorizontalAlignment="Center" Foreground="{StaticResource TextBrush}" />
                                <TextBlock Text="移入上方“＋”区域，点击鼠标按键即可开始指定动作"
                                           FontSize="11.5" Foreground="{StaticResource MutedTextBrush}"
                                           HorizontalAlignment="Center" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                        <ListBox Grid.Row="1" x:Name="RemapsList" ItemsSource="{Binding Source={StaticResource GroupedRemaps}}"
                                 Background="Transparent" BorderThickness="0"
                                 ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.GroupStyle>
                                    <GroupStyle>
                                        <GroupStyle.ContainerStyle>
                                            <Style TargetType="{x:Type GroupItem}">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="{x:Type GroupItem}">
                                                            <StackPanel Margin="0">
                                                                <ContentPresenter 
                                                                                   />
                                                                <ItemsPresenter Margin="0" />
                                                            </StackPanel>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </GroupStyle.ContainerStyle>
                                        <GroupStyle.HeaderTemplate>
                                            <DataTemplate>
                                                <Border Background="#F9FAFB" Padding="0" BorderThickness="0,0,0,1" BorderBrush="#E3E3E3">
                                                    <Grid Height="24">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="130" />
                                                            <ColumnDefinition Width="1" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center" Margin="10,0">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Text" Value="鼠标按键" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Name}" Value="MButton"><Setter Property="Text" Value="中键" /></DataTrigger>
                                                                        <DataTrigger Binding="{Binding Name}" Value="XButton1"><Setter Property="Text" Value="按键 4" /></DataTrigger>
                                                                        <DataTrigger Binding="{Binding Name}" Value="XButton2"><Setter Property="Text" Value="按键 5" /></DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                        <Rectangle Grid.Column="1" Fill="#E3E3E3" Width="1" VerticalAlignment="Stretch" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </GroupStyle.HeaderTemplate>
                                    </GroupStyle>
                                </ListBox.GroupStyle>
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="Margin" Value="0" />
                                        <Setter Property="BorderThickness" Value="0" />
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" Padding="0" Margin="0">
                                                        <ContentPresenter />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="ItemBorder" Property="Background" Value="#F9FAFB" />
                                                        </Trigger>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="ItemBorder" Property="Background" Value="Transparent" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderThickness="0,0,0,1" BorderBrush="#E3E3E3" Padding="0">
                                            <Grid Height="39">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="130" />
                                                    <ColumnDefinition Width="1" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0">
                                                    <Button Width="15" Height="15" MinWidth="15" MinHeight="15" Padding="0"
                                                            CommandParameter="{Binding}" Click="RemoveRemap_Click" ToolTip="删除映射"
                                                            Cursor="Hand">
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border Background="#E5E7EB" CornerRadius="3" Width="15" Height="15">
                                                                    <TextBlock Text="−" FontSize="11" FontWeight="Bold" Foreground="#4B5563"
                                                                               HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0" />
                                                                </Border>
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                    </Button>
                                                    <TextBlock Grid.Column="1" Style="{StaticResource TriggerLabel}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                                </StackPanel>

                                                <Rectangle Grid.Column="1" Fill="#E3E3E3" Width="1" VerticalAlignment="Stretch" />

                                                <ComboBox Grid.Column="2" Margin="6,0,6,0"
                                                          Style="{StaticResource MacPopUpComboBox}"
                                                          HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                                          ToolTip="选择这个操作要执行的动作。"
                                                          ItemsSource="{Binding Trigger, Converter={StaticResource TriggerActionOptionsConverter}}"
                                                          SelectedValuePath="Type"
                                                          PreviewMouseWheel="RemapComboBox_PreviewMouseWheel"
                                                          SelectedValue="{Binding Action.Type, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                                    <ComboBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding Name}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                                        </DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                </ComboBox>
                                                <TextBox Grid.Column="3" Width="110" Margin="0,0,8,0" ToolTip="例如 Ctrl+Shift+T"
                                                         Visibility="{Binding Action.Type, Converter={StaticResource ActionTypeToVisibilityConverter}}"
                                                         Text="{Binding Action.Shortcut, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>

                <Grid Grid.Row="3" Margin="0,6,0,0">
                    <Button Content="选项…" MinWidth="68" Padding="12,4" HorizontalAlignment="Left" Click="OpenButtonOptions_Click" />
                    <Button Content="恢复默认值…" MinWidth="80" Padding="12,4" HorizontalAlignment="Right" Click="RestoreDefaults_Click" />
                </Grid>
            </Grid>

            <ScrollViewer x:Name="ScrollPage" Visibility="Collapsed" VerticalScrollBarVisibility="Disabled"
                          HorizontalScrollBarVisibility="Disabled"
                          HorizontalContentAlignment="Center">
                <StackPanel Width="440" Margin="0,14,0,18">
                    <TextBlock Text="调整鼠标滚轮的物理运动表现与手感。" Style="{StaticResource PageDescription}" />

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="滚动模式" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="选择鼠标滚轮的物理表现；原生模式下完全不干涉系统速度与触控板。"
                                       Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,16" />

                            <RadioButton x:Name="ScrollModeNativeRadio" GroupName="ScrollMode" Margin="0,0,0,14"
                                         Checked="ScrollModeRadio_Checked">
                                <StackPanel Margin="6,0,0,0">
                                    <TextBlock Text="Windows 原生模式" FontWeight="SemiBold" />
                                    <TextBlock Text="软件完全不介入滚轮速度，系统、触控板与鼠标驱动完全保持原生手感。"
                                               Foreground="{StaticResource MutedTextBrush}" FontSize="12" Margin="0,2,0,0" />
                                </StackPanel>
                            </RadioButton>

                            <RadioButton x:Name="ScrollModeSmoothRadio" GroupName="ScrollMode" Margin="0,0,0,14"
                                         Checked="ScrollModeRadio_Checked">
                                <StackPanel Margin="6,0,0,0">
                                    <TextBlock Text="平滑流动模式" FontWeight="SemiBold" />
                                    <TextBlock Text="平滑离散齿轮刻度，消除逐格跳跃感，适合机械滚轮。"
                                               Foreground="{StaticResource MutedTextBrush}" FontSize="12" Margin="0,2,0,0" />
                                </StackPanel>
                            </RadioButton>

                            <RadioButton x:Name="ScrollModeInertiaRadio" GroupName="ScrollMode"
                                         Checked="ScrollModeRadio_Checked">
                                <StackPanel Margin="6,0,0,0">
                                    <TextBlock Text="惯性飞轮模式" FontWeight="SemiBold" />
                                    <TextBlock Text="快速拨动滚轮后带有自然减速的动量滑行尾巴，适合长页面浏览。"
                                               Foreground="{StaticResource MutedTextBrush}" FontSize="12" Margin="0,2,0,0" />
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="反向滚动" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="让滚轮方向与 Windows 默认方向相反。" Foreground="{StaticResource MutedTextBrush}" />
                            </StackPanel>
                            <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                                      AutomationProperties.Name="反向滚动"
                                      IsChecked="{Binding Scroll.Reverse, Mode=TwoWay}" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="滚轮速度" Style="{StaticResource SectionTitle}" />
                                    <TextBlock x:Name="ScrollSpeedDescription" Text="较低适合精细阅读，较高适合快速浏览。" Foreground="{StaticResource MutedTextBrush}" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" x:Name="ScrollSpeedText" Text="1.0×" FontSize="18"
                                           FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}" VerticalAlignment="Center" />
                            </Grid>
                            <Slider x:Name="ScrollSpeedSlider" Minimum="0.25" Maximum="4" TickFrequency="0.25" IsSnapToTickEnabled="True"
                                    Style="{StaticResource SliderStyle}"
                                    Value="{Binding Scroll.Speed, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    ValueChanged="ScrollSpeed_ValueChanged" />
                            <Grid Margin="0,6,0,0">
                                <TextBlock Text="0.25×" Foreground="{StaticResource MutedTextBrush}" FontSize="11" />
                                <TextBlock Text="4×" Foreground="{StaticResource MutedTextBrush}" FontSize="11" HorizontalAlignment="Right" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>


                    <ScrollViewer x:Name="AboutPage" Visibility="Collapsed" VerticalScrollBarVisibility="Disabled"
                          HorizontalScrollBarVisibility="Disabled"
                          HorizontalContentAlignment="Center">
                <StackPanel Width="440" Margin="0,14,0,18">
                    <TextBlock Text="Win Mouse Fix 项目版本、更新检查与开源许可信息。" Style="{StaticResource PageDescription}" />
                    <!-- 卡片 3：关于、更新与项目信息 -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Win Mouse Fix" Style="{StaticResource SectionTitle}" />
                                    <TextBlock x:Name="AboutVersionText" Text="版本" Foreground="{StaticResource MutedTextBrush}" FontSize="11.5" />
                                </StackPanel>
                                <Image Grid.Column="1" Width="36" Height="36" Source="/assets/WinMouseFix.png"
                                       Stretch="Uniform" SnapsToDevicePixels="True"
                                       AutomationProperties.Name="Win Mouse Fix 图标" />
                            </Grid>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="作者" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,6" />
                                <TextBlock Grid.Column="1" Text="胡文凯" Margin="0,0,0,6" />
                                <TextBlock Grid.Row="1" Text="项目主页" Foreground="{StaticResource MutedTextBrush}" />
                                <StackPanel Grid.Row="1" Grid.Column="1">
                                    <TextBlock x:Name="ProjectHomepageText" Text="正在检测 GitHub / Gitee" />
                                    <TextBlock x:Name="AboutSourceStatusText" Margin="0,2,0,0"
                                               Foreground="{StaticResource MutedTextBrush}" FontSize="11"
                                               Text="将根据网络自动选择 GitHub 或 Gitee" />
                                </StackPanel>
                            </Grid>

                            <!-- 操作按钮组 -->
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button x:Name="CheckForUpdatesButton" Content="检查更新" Style="{StaticResource PrimaryButton}"
                                        Click="CheckForUpdates_Click" Margin="0,0,8,0" />
                                <Button x:Name="DownloadUpdateButton" Content="下载更新" Style="{StaticResource PrimaryButton}"
                                        Click="DownloadUpdate_Click" Margin="0,0,8,0" Visibility="Collapsed" />
                                <Button x:Name="CancelUpdateButton" Content="取消下载" Click="CancelUpdate_Click"
                                        Margin="0,0,8,0" Visibility="Collapsed" />
                                <Button x:Name="InstallUpdateButton" Content="立即安装" Style="{StaticResource PrimaryButton}"
                                        Click="InstallUpdate_Click" Margin="0,0,8,0" Visibility="Collapsed" />
                                <Button x:Name="OpenProjectHomepageButton" Content="打开主页" Click="OpenProjectHomepage_Click" Margin="0,0,8,0" />
                                <Button x:Name="OpenLicenseButton" Content="查看许可" Click="OpenLicense_Click" />
                            </StackPanel>

                            <StackPanel x:Name="UpdateProgressPanel" Margin="0,10,0,0" Visibility="Collapsed">
                                <ProgressBar x:Name="UpdateProgressBar" Height="6" Minimum="0" Maximum="100" />
                                <TextBlock x:Name="UpdateStatusText" Margin="0,4,0,0" Foreground="{StaticResource MutedTextBrush}" FontSize="11" />
                            </StackPanel>

                            <Border Height="1" Background="#F0F0F0" Margin="0,12,0,8" />

                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="获取 Beta 版测试更新" FontWeight="SemiBold" FontSize="12" />
                                    <TextBlock Text="开启后同时检查测试版本；默认只检查正式发布。" Foreground="{StaticResource MutedTextBrush}" FontSize="11" />
                                </StackPanel>
                                <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                                          AutomationProperties.Name="获取 Beta 版更新"
                                          IsChecked="{Binding ReceiveBetaUpdates, Mode=TwoWay}" />
                            </Grid>

                            <Border Height="1" Background="#F0F0F0" Margin="0,8,0,8" />

                            <StackPanel Margin="0,2,0,0">
                                <TextBlock Text="配置文件位置" FontWeight="SemiBold" FontSize="11.5" Foreground="{StaticResource MutedTextBrush}" />
                                <TextBlock x:Name="ConfigPathText" Foreground="{StaticResource MutedTextBrush}" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- 现代悬浮浮岛通知胶囊 (Floating HUD Capsule) -->
        <Border x:Name="StatusHud" Grid.Row="1"
                HorizontalAlignment="Center" VerticalAlignment="Bottom"
                Margin="0,0,0,20" CornerRadius="15"
                Background="#1E232A" BorderBrush="#363C47" BorderThickness="1"
                Padding="14,6,16,6" Opacity="0" Visibility="Collapsed"
                IsHitTestVisible="False">
            <Border.RenderTransform>
                <TranslateTransform x:Name="StatusHudTransform" Y="8" />
            </Border.RenderTransform>
            <Border.Effect>
                <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.25" Color="#000000" />
            </Border.Effect>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="StatusHudIcon" Text="&#xE73E;"
                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                           FontSize="12" Foreground="#34D399"
                           VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBlock x:Name="StatusMessageText" Foreground="#F3F4F6"
                           FontSize="12" FontWeight="Normal" VerticalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
